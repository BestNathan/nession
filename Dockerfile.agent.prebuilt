# Minimal agent image — packages pre-built binary + nginx + web UI + tmux
#
# bookworm, not bullseye: Debian 11 reached end of LTS on 2026-08-31 and its
# security pool is gone, so the `apt-get install` below 404s on every package.

# Build the pinned EROFS helper tools (#3178). Debian bookworm's erofs-utils
# 1.5 packages no erofsfuse, so the FUSE mount helper comes from the same
# pinned upstream build the from-source path uses.
FROM debian:bookworm-slim AS erofs-utils-builder
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential autoconf automake libtool pkg-config libfuse3-dev \
        ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY deploy/build-erofs-utils.sh /usr/local/bin/build-erofs-utils.sh
RUN chmod +x /usr/local/bin/build-erofs-utils.sh && \
    /usr/local/bin/build-erofs-utils.sh

# Agent runtime base (#3178). `Dockerfile.agent` extends the identical stage,
# so both final Agent images carry one packaging definition. `git` backs
# `GitAgentExtension`; `bubblewrap` is the Linux Sandbox launcher; `erofsfuse`
# (pinned source build), `fusermount3` (`fuse3`) and `fuse-overlayfs` back
# `crates/nession-sandbox/src/linux/erofs.rs`. Namespace creation and delegated
# cgroup v2 remain host/runtime prerequisites. The probe fails the image build
# if any executable is absent.
FROM debian:bookworm-slim AS runtime-tools
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx ca-certificates curl gettext-base git bubblewrap fuse3 fuse-overlayfs && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /etc/nginx/sites-enabled/default
COPY --from=erofs-utils-builder /usr/local/bin/erofsfuse /usr/local/bin/erofsfuse
RUN command -v git erofsfuse fusermount3 fuse-overlayfs

# Final image
FROM runtime-tools AS runtime
ARG DEBIAN_FRONTEND=noninteractive
# The release-selected fixed terminal width (#2487), carried to the Agent's
# process environment. The entrypoint writes it into agent-config.toml; it is
# the creation width for a Session with no pane yet and the standalone policy.
ARG NESSION_TERMINAL_COLS=96
ENV NESSION_TERMINAL_COLS=${NESSION_TERMINAL_COLS}

# Install tmux from static builds (https://github.com/tmux/tmux-builds)
# Uses multi-arch binaries: v3.6b, linux-amd64 / linux-arm64.
# Pinned to 3.6b (same version as Homebrew on macOS) — SGR mouse works correctly.
ARG TARGETARCH
RUN TMUX_ARCH=$(case "${TARGETARCH}" in amd64) echo "x86_64" ;; arm64) echo "arm64" ;; *) echo "x86_64" ;; esac) && \
    TMUX_VERSION="3.6b" && \
    curl -fsSL "https://github.com/tmux/tmux-builds/releases/download/v${TMUX_VERSION}/tmux-${TMUX_VERSION}-linux-${TMUX_ARCH}.tar.gz" \
        -o /tmp/tmux.tar.gz && \
    tar -xzf /tmp/tmux.tar.gz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/tmux && \
    rm /tmp/tmux.tar.gz && \
    tmux -V

# Node.js 22 + Claude Code (baked in instead of k8s init container).
# Replaces the old initContainer-based install which re-downloaded
# on every pod recreation because emptyDir doesn't survive across
# deployments.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm config set registry https://registry.npmmirror.com && \
    npm install -g @anthropic-ai/claude-code && \
    apt-get purge -y curl && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Claude Code one-time init config (skips onboarding on first run)
RUN mkdir -p /root/.claude && \
    printf '{"hasCompletedOnboarding":true}\n' > /root/.claude.json

# tmux configuration (mouse, vi-mode keys, focus events)
#
# No history-limit: the agent owns that value now, as a server default it sets
# itself. See Dockerfile.agent and #321.
RUN printf 'set -g mouse on\nsetw -g mode-keys vi\nset -g focus-events on\n' > /root/.tmux.conf

# Stable files first — rarely change, always cache-hit
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/entrypoint-agent.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
# Durable Agent data root (#3023). A Kubernetes deployment mounts its
# existing PVC at /data and sets the EROFS cache under it. An OCI `VOLUME` is
# NOT a PVC: without an explicitly mounted durable volume, /data (and therefore
# this cache) belongs to the container writable layer and disappears with it.
RUN mkdir -p /data /data/erofs /etc/nession

# Volatile files last — only these layers rebuild on each commit
# Web UI static files (built once, shared across archs)
COPY --from=web-dist / /usr/share/nginx/html/
# Binary from rust build (arch-specific)
COPY --from=agent-bin /nession-agent /usr/local/bin/nession-agent
RUN chmod +x /usr/local/bin/nession-agent

WORKDIR /etc/nession

EXPOSE 10080 19090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:10080/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
