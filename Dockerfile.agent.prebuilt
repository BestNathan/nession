# Minimal agent image — packages pre-built binary + nginx + web UI + tmux
#
# bookworm, not bullseye: Debian 11 reached end of LTS on 2026-08-31 and its
# security pool is gone, so the `apt-get install` below 404s on every package.

# Build the pinned EROFS helper tools (#3178). Debian bookworm's erofs-utils
# 1.5 packages no erofsfuse, so the FUSE mount helper comes from the same
# pinned upstream build the from-source path uses.
ARG AGENT_DEBIAN_BASE_IMAGE=debian:bookworm-20261104-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
FROM debian:bookworm-20261104-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS erofs-utils-builder
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential autoconf automake libtool pkg-config libfuse3-dev \
        ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY deploy/build-erofs-utils.sh /usr/local/bin/build-erofs-utils.sh
# Shared source identity for Server and Agent; overrides must supply BOTH
# release version and checksum, which the build script verifies fail-closed.
ARG EROFS_UTILS_VERSION=1.9.4
ARG EROFS_UTILS_SHA256=7d135aa2550326a5acf20f53c518aea5a8900015ce50700044e40f818c31dd80
RUN chmod +x /usr/local/bin/build-erofs-utils.sh && \
    EROFS_UTILS_VERSION="${EROFS_UTILS_VERSION}" \
    EROFS_UTILS_SHA256="${EROFS_UTILS_SHA256}" \
    /usr/local/bin/build-erofs-utils.sh

# Agent runtime base (#3178). `Dockerfile.agent` extends the identical stage,
# so both final Agent images carry one packaging definition. `git` backs
# `GitAgentExtension`; `bubblewrap` is the Linux Sandbox launcher; `erofsfuse`
# (pinned source build), `fusermount3` (`fuse3`) and `fuse-overlayfs` back
# `crates/nession-sandbox/src/linux/erofs.rs`. Namespace creation and delegated
# cgroup v2 remain host/runtime prerequisites. The probe fails the image build
# if any executable is absent.
# Versioned Debian runtime; a dated tag is selected explicitly so rebuilding
# the same commit cannot silently migrate Debian minor releases.
FROM ${AGENT_DEBIAN_BASE_IMAGE} AS runtime-tools
ARG DEBIAN_FRONTEND=noninteractive
ARG AGENT_NGINX_VERSION=1.22.1-9+deb12u11
ARG AGENT_CA_CERTIFICATES_VERSION=20250419~deb12u2
ARG AGENT_CURL_VERSION=7.88.1-10+deb12u15
ARG AGENT_GETTEXT_BASE_VERSION=0.21-12
ARG AGENT_GIT_VERSION=1:2.39.5-0+deb12u3
ARG AGENT_BUBBLEWRAP_VERSION=0.8.0-2+deb12u1
ARG AGENT_FUSE3_VERSION=3.14.0-4
ARG AGENT_FUSE_OVERLAYFS_VERSION=1.10-1
# Explicit Debian package versions, not floating apt latest. Removed package
# revisions fail closed; upgrades require an explicit reviewed ARG change.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        "nginx=${AGENT_NGINX_VERSION}" "ca-certificates=${AGENT_CA_CERTIFICATES_VERSION}" \
        "curl=${AGENT_CURL_VERSION}" "gettext-base=${AGENT_GETTEXT_BASE_VERSION}" \
        "git=${AGENT_GIT_VERSION}" "bubblewrap=${AGENT_BUBBLEWRAP_VERSION}" \
        "fuse3=${AGENT_FUSE3_VERSION}" "fuse-overlayfs=${AGENT_FUSE_OVERLAYFS_VERSION}" && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /etc/nginx/sites-enabled/default
COPY --from=erofs-utils-builder /usr/local/bin/erofsfuse /usr/local/bin/erofsfuse
RUN command -v git erofsfuse fusermount3 fuse-overlayfs

# Final image
FROM runtime-tools AS runtime
ARG DEBIAN_FRONTEND=noninteractive
# The release-selected fixed terminal width (#2487), carried to the Agent's
# process environment. The entrypoint writes it into agent-config.toml; it is
# the creation width for a Session with no pane yet and the standalone policy.
ARG NESSION_TERMINAL_COLS=96
ENV NESSION_TERMINAL_COLS=${NESSION_TERMINAL_COLS}

# Install tmux from static builds (https://github.com/tmux/tmux-builds)
# Uses multi-arch binaries: v3.6b, linux-amd64 / linux-arm64.
# Pinned to 3.6b (same version as Homebrew on macOS) — SGR mouse works correctly.
ARG TARGETARCH
ARG AGENT_TMUX_VERSION=3.6b
RUN TMUX_ARCH=$(case "${TARGETARCH}" in amd64) echo "x86_64" ;; arm64) echo "arm64" ;; *) exit 2 ;; esac) && \
    curl -fsSL "https://github.com/tmux/tmux-builds/releases/download/v${AGENT_TMUX_VERSION}/tmux-${AGENT_TMUX_VERSION}-linux-${TMUX_ARCH}.tar.gz" \
        -o /tmp/tmux.tar.gz && \
    tar -xzf /tmp/tmux.tar.gz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/tmux && \
    rm /tmp/tmux.tar.gz && \
    test "$(tmux -V)" = "tmux ${AGENT_TMUX_VERSION}"

# Node.js 22 + Claude Code (baked in instead of k8s init container).
# Replaces the old initContainer-based install which re-downloaded
# on every pod recreation because emptyDir doesn't survive across
# deployments.
# Pinned NodeSource package and pinned Claude Code (no implicit latest).
# Keep this expensive stable toolchain *before* the volatile Web/binary COPY.
COPY deploy/setup-nodesource.sh /usr/local/bin/setup-nodesource.sh
ARG AGENT_NODESOURCE_GPG_FINGERPRINT=6F71F525282841EEDAF851B42F59B5F99B1BE0B4
ARG AGENT_NODEJS_VERSION=22.23.5-1nodesource1
ARG AGENT_CLAUDE_CODE_VERSION=2.1.323
# Disable post-start self-update: runtime must execute exactly the image version.
ENV DISABLE_AUTOUPDATER=1
RUN AGENT_NODESOURCE_GPG_FINGERPRINT="${AGENT_NODESOURCE_GPG_FINGERPRINT}" \
      /bin/sh /usr/local/bin/setup-nodesource.sh && \
    apt-get install -y --no-install-recommends "nodejs=${AGENT_NODEJS_VERSION}" && \
    test "$(node --version)" = "v${AGENT_NODEJS_VERSION%%-*}" && \
    npm config set registry https://registry.npmjs.org && \
    npm install -g --no-audit --no-fund "@anthropic-ai/claude-code@${AGENT_CLAUDE_CODE_VERSION}" && \
    node -e 'const p=require("child_process").execFileSync("npm",["ls","-g","--json","--depth=0"],{encoding:"utf8"});const installed=JSON.parse(p).dependencies?.["@anthropic-ai/claude-code"]?.version;if(installed!==process.argv[1])process.exit(1)' "${AGENT_CLAUDE_CODE_VERSION}" && \
    rm -rf /root/.npm /var/lib/apt/lists/*

# Claude Code one-time init config (skips onboarding on first run)
RUN mkdir -p /root/.claude && \
    printf '{"hasCompletedOnboarding":true}\n' > /root/.claude.json

# tmux configuration (mouse, vi-mode keys, focus events)
#
# No history-limit: the agent owns that value now, as a server default it sets
# itself. See Dockerfile.agent and #321.
RUN printf 'set -g mouse on\nsetw -g mode-keys vi\nset -g focus-events on\n' > /root/.tmux.conf

# Stable files first — rarely change, always cache-hit
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/entrypoint-agent.sh /entrypoint.sh
COPY deploy/render-mcp-config.sh /render-mcp-config.sh
RUN chmod +x /entrypoint.sh /render-mcp-config.sh
# Durable Agent data root (#3023). A Kubernetes deployment mounts its
# existing PVC at /data and sets the EROFS cache under it. An OCI `VOLUME` is
# NOT a PVC: without an explicitly mounted durable volume, /data (and therefore
# this cache) belongs to the container writable layer and disappears with it.
RUN mkdir -p /data /data/erofs /etc/nession

# Volatile files last — only these layers rebuild on each commit
# Web UI static files (built once, shared across archs)
COPY --from=web-dist / /usr/share/nginx/html/
# Binary from rust build (arch-specific)
COPY --from=agent-bin /nession-agent /usr/local/bin/nession-agent
RUN chmod +x /usr/local/bin/nession-agent

WORKDIR /etc/nession

EXPOSE 10080 19090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:10080/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
