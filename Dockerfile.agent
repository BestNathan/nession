# ---- Build stages (shared with server via Docker build context) ----

# Stage 1: Prepare cargo-chef recipe
FROM rust:1.96-bullseye AS planner
WORKDIR /build
RUN cargo install cargo-chef --locked
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 2: Build dependencies (cached)
FROM rust:1.96-bullseye AS cacher
WORKDIR /build
RUN cargo install sccache --locked
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/sccache
ENV CARGO_INCREMENTAL=0
RUN cargo install cargo-chef --locked
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json

# Stage 3: Build web UI
FROM node:20-alpine AS web-builder
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
RUN npm run build

# Stage 4: Build agent binary
FROM rust:1.96-bullseye AS rust-builder
WORKDIR /build
RUN cargo install sccache --locked
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/sccache
ENV CARGO_INCREMENTAL=0
COPY --from=cacher /build/target target
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY . .
RUN cargo build --release --bin nession-agent

# Stage 5: Agent runtime (includes tmux — agent manages tmux sessions)
FROM debian:bullseye-slim AS runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx ca-certificates curl gettext-base && \
    rm -rf /var/lib/apt/lists/*

# Install tmux from static builds (https://github.com/tmux/tmux-builds)
# Uses multi-arch binaries: v3.6b, linux-amd64 / linux-arm64.
# Pinned to 3.6b (same version as Homebrew on macOS) — SGR mouse works correctly.
ARG TARGETARCH
RUN TMUX_ARCH=$(case "${TARGETARCH}" in amd64) echo "x86_64" ;; arm64) echo "arm64" ;; *) echo "x86_64" ;; esac) && \
    TMUX_VERSION="3.6b" && \
    curl -fsSL "https://github.com/tmux/tmux-builds/releases/download/v${TMUX_VERSION}/tmux-${TMUX_VERSION}-linux-${TMUX_ARCH}.tar.gz" \
        -o /tmp/tmux.tar.gz && \
    tar -xzf /tmp/tmux.tar.gz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/tmux && \
    rm /tmp/tmux.tar.gz && \
    tmux -V

# Node.js 22 + Claude Code (baked in instead of k8s init container).
# Replaces the old initContainer-based install which re-downloaded
# on every pod recreation because emptyDir doesn't survive across
# deployments.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm config set registry https://registry.npmmirror.com && \
    npm install -g @anthropic-ai/claude-code && \
    apt-get purge -y curl && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Claude Code one-time init config (skips onboarding on first run)
RUN mkdir -p /root/.claude && \
    printf '{"hasCompletedOnboarding":true}\n' > /root/.claude.json

# tmux configuration (mouse, scrollback, vi-mode keys, focus events)
RUN printf 'set -g mouse on\nset -g history-limit 50000\nsetw -g mode-keys vi\nset -g focus-events on\n' > /root/.tmux.conf

COPY --from=rust-builder /build/target/release/nession-agent /usr/local/bin/nession-agent
COPY --from=web-builder /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/entrypoint-agent.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN mkdir -p /etc/nession
RUN rm -f /etc/nginx/sites-enabled/default

WORKDIR /etc/nession

# Port 10080: nginx (web UI + proxy)
# Port 19090: agent WebSocket (for clients to connect directly)
EXPOSE 10080 19090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:10080/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
