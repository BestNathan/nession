#!/usr/bin/env bash
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ── Staged files ─────────────────────────────────────────────────────────
STAGED_RUST=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
STAGED_TSX=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep '^web/' || true)
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM)

# ── Nothing to check ─────────────────────────────────────────────────────
if [ -z "$STAGED_ALL" ]; then
  exit 0
fi

HAS_ERROR=0

# ── Rust: fmt ────────────────────────────────────────────────────────────
if [ -n "$STAGED_RUST" ]; then
  echo -e "${YELLOW}→ cargo fmt --all -- --check${NC}"
  if ! cargo fmt --all -- --check 2>/dev/null; then
    echo -e "${RED}✗ cargo fmt failed — run 'cargo fmt --all' to fix${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ cargo fmt${NC}"
  fi

  echo -e "${YELLOW}→ cargo clippy --workspace -- -D warnings${NC}"
  if ! cargo clippy --workspace -- -D warnings 2>&1; then
    echo -e "${RED}✗ cargo clippy failed — fix the warnings above${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ cargo clippy${NC}"
  fi
fi

# ── Web: ESLint ──────────────────────────────────────────────────────────
if [ -n "$STAGED_TSX" ]; then
  echo -e "${YELLOW}→ web: eslint --max-warnings 0${NC}"
  if ! (cd web && npx eslint . --report-unused-disable-directives --max-warnings 0 2>/dev/null); then
    echo -e "${RED}✗ eslint failed — run 'cd web && npm run lint' to see details${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ eslint${NC}"
  fi
fi

# ── Result ───────────────────────────────────────────────────────────────
if [ $HAS_ERROR -eq 1 ]; then
  echo -e "\n${RED}Commit blocked — fix the issues above and try again${NC}"
  exit 1
fi

echo -e "\n${GREEN}All checks passed ✓${NC}"
exit 0
