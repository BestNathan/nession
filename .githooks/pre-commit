#!/usr/bin/env bash
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ── Staged files ─────────────────────────────────────────────────────────
STAGED_RUST=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
STAGED_TSX=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep '^web/' || true)
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM)

# ── Nothing to check ─────────────────────────────────────────────────────
if [ -z "$STAGED_ALL" ]; then
  exit 0
fi

HAS_ERROR=0

# ── Rust: fmt ───────────────────────────────────────────────────────────
if [ -n "$STAGED_RUST" ]; then
  echo -e "${YELLOW}→ cargo fmt --all -- --check${NC}"
  if ! cargo fmt --all -- --check 2>/dev/null; then
    echo -e "${RED}✗ cargo fmt failed — run 'cargo fmt --all' to fix${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ cargo fmt${NC}"
  fi

  echo -e "${YELLOW}→ cargo clippy --workspace -- -D warnings${NC}"
  if ! RUSTFLAGS="-D warnings" cargo clippy --workspace -- -D warnings 2>&1; then
    echo -e "${RED}✗ cargo clippy failed — fix the warnings above${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ cargo clippy${NC}"
  fi

  # Also check test compilation with -D warnings (matches CI behavior)
  echo -e "${YELLOW}→ cargo test --no-run (with -D warnings, matches CI)${NC}"
  if ! RUSTFLAGS="-D warnings" cargo test --workspace --no-run 2>&1; then
    echo -e "${RED}✗ test compilation failed — see errors above${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ test compiles${NC}"
  fi

  echo -e "${YELLOW}→ cargo test${NC}"
  if ! cargo test 2>&1; then
    echo -e "${RED}✗ cargo test failed — fix the failing tests${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ cargo test${NC}"
  fi

  # Determine which crates have staged changes to focus coverage on
  CHANGED_CRATES=()
  for crate in nession-common nession-agent nession-server nession-cli; do
    if echo "$STAGED_RUST" | grep -q "^crates/${crate}/"; then
      CHANGED_CRATES+=("$crate")
    fi
  done

  if [ ${#CHANGED_CRATES[@]} -gt 0 ]; then
    echo -e "${YELLOW}→ rust: coverage check for changed crates: ${CHANGED_CRATES[*]}${NC}"
    if ! ./scripts/check-coverage.sh "${CHANGED_CRATES[@]}" 2>&1; then
      echo -e "${RED}✗ coverage check failed — see details above${NC}"
      HAS_ERROR=1
    else
      echo -e "${GREEN}✓ coverage${NC}"
    fi
  fi
fi

# ── Web: ESLint + TSC ────────────────────────────────────────────────────
if [ -n "$STAGED_TSX" ]; then
  echo -e "${YELLOW}→ web: eslint --max-warnings 0${NC}"
  if ! (cd web && npx eslint . --report-unused-disable-directives --max-warnings 0 2>/dev/null); then
    echo -e "${RED}✗ eslint failed — run 'cd web && npm run lint' to see details${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ eslint${NC}"
  fi

  echo -e "${YELLOW}→ web: tsc --noEmit${NC}"
  if ! (cd web && npx tsc --noEmit 2>/dev/null); then
    echo -e "${RED}✗ tsc failed — run 'cd web && npx tsc --noEmit' to see details${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ tsc${NC}"
  fi

  echo -e "${YELLOW}→ web: npm test${NC}"
  if ! (cd web && npx vitest run --reporter=default 2>/dev/null); then
    echo -e "${RED}✗ npm test failed — fix the failing tests${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ npm test${NC}"
  fi

  echo -e "${YELLOW}→ web: test coverage thresholds${NC}"
  if ! (cd web && npx vitest run --coverage --reporter=default >/dev/null 2>&1); then
    echo -e "${RED}✗ coverage below threshold — run 'cd web && npm run coverage' to see details${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ coverage${NC}"
  fi
fi

# ── Result ───────────────────────────────────────────────────────────────
if [ $HAS_ERROR -eq 1 ]; then
  echo -e "\n${RED}Commit blocked — fix the issues above and try again${NC}"
  exit 1
fi

echo -e "\n${GREEN}All checks passed ✓${NC}"
exit 0
