#!/usr/bin/env bash
set -euo pipefail

# Non-Gate maintenance: relocate incidental screenshots before validating the
# staged tree. All blocking policy and changed-file routing belong to gates/.
if compgen -G "*.png" >/dev/null 2>&1; then
  ./scripts/move-screenshots.sh
fi
staged_root_pngs="$(git diff --cached --name-only | grep -E '^[^/]+\.png$' || true)"
if [ -n "$staged_root_pngs" ]; then
  git reset -q HEAD -- $staged_root_pngs 2>/dev/null || true
  echo "→ unstaged root PNGs (moved to .playwright-mcp/screenshots/)"
fi

exec ./gates/route pre-commit
