#!/usr/bin/env bash
set -euo pipefail

# Workspace policy remains mandatory even when the pushed diff is unrelated.
./gates/run dev-workspace-push

# shellcheck source=scripts/lib/git-diff-base.sh
. ./scripts/lib/git-diff-base.sh

HAS_RUST=0
HAS_WEB=0
HAS_DESIGN=0
HAS_PROTOCOL=0
HAS_GATE=0
HAS_TMUX=0
HAS_TEST_ISOLATION=0
HAS_INSTRUCTIONS=0

while read -r local_ref local_sha _remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    if resolved="$(resolve_diff_base "$local_ref" "$local_sha")"; then
      base_source="${resolved%% *}"
      remote_sha="${resolved#* }"
      if [ "$base_source" = creation_point ]; then
        echo "→ new branch: diff from creation point ${remote_sha:0:7}"
      else
        echo "→ new branch: diff from merge-base ${remote_sha:0:7}"
      fi
    else
      echo "→ new branch: no usable diff base; running full source Gate profile"
      HAS_RUST=1; HAS_WEB=1; HAS_DESIGN=1; HAS_PROTOCOL=1
      HAS_GATE=1; HAS_TMUX=1; HAS_TEST_ISOLATION=1; HAS_INSTRUCTIONS=1
      continue
    fi
  fi

  # Preserve the existing routing buckets and add Gate/self-test owner paths.
  changed="$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)"
  if grep -Eq '\.rs$|^Cargo\.(toml|lock)$|^rust-toolchain\.toml$|^\.cargo/|^gates/checks/rust-' <<< "$changed"; then HAS_RUST=1; fi
  if grep -Eq '^web/.*\.(ts|tsx|js|css)$|^gates/checks/web-' <<< "$changed"; then HAS_WEB=1; fi
  if grep -Eq '^(design/|docs/design/|web/eslint-plugin-nession/|scripts/check-design-tokens|\.claude/skills/nession-web-design/|justfile$|gates/checks/design-system-)' <<< "$changed"; then HAS_DESIGN=1; fi
  if grep -Eq '^(crates/nession-protocol/|crates/[^/]+/src/protocol/|crates/nession-protocol-codegen/|web/src/generated/protocol/|scripts/protocol-gate|gates/checks/protocol-)' <<< "$changed"; then HAS_PROTOCOL=1; fi
  if grep -Eq '^(gates/|\.githooks/(pre-commit|pre-push)$|justfile$)' <<< "$changed"; then HAS_GATE=1; fi
  if grep -Eq '^(scripts/check-tmux-socket|gates/checks/tmux-socket-isolation)' <<< "$changed"; then HAS_TMUX=1; fi
  if grep -Eq '^(scripts/check-test-isolation|gates/checks/test-isolation)' <<< "$changed"; then HAS_TEST_ISOLATION=1; fi
  if grep -Eq '(^|/)(AGENTS|CLAUDE)\.md$|^\.agents/|^\.claude/skills/|^scripts/instruction-contract|^gates/checks/instruction-contract\.sh$' <<< "$changed"; then HAS_INSTRUCTIONS=1; fi
done

GATE_IDS=()
if [ "$HAS_RUST" -eq 1 ]; then
  GATE_IDS+=(rust-test-unit rust-test-integration rust-coverage)
fi
if [ "$HAS_PROTOCOL" -eq 1 ]; then
  GATE_IDS+=(protocol-integrity protocol-codegen-drift)
fi
if [ "$HAS_WEB" -eq 1 ] || [ "$HAS_DESIGN" -eq 1 ]; then
  GATE_IDS+=(design-system-full)
fi
if [ "$HAS_WEB" -eq 1 ]; then
  GATE_IDS+=(web-test-unit web-test-integration web-coverage)
fi
if [ "$HAS_GATE" -eq 1 ]; then
  GATE_IDS+=(gate-runtime-contract)
fi
if [ "$HAS_PROTOCOL" -eq 1 ]; then
  GATE_IDS+=(protocol-integrity-selftest)
fi
if [ "$HAS_TMUX" -eq 1 ]; then
  GATE_IDS+=(tmux-socket-isolation tmux-socket-isolation-selftest)
fi
if [ "$HAS_TEST_ISOLATION" -eq 1 ]; then
  GATE_IDS+=(test-isolation test-isolation-selftest)
fi
if [ "$HAS_INSTRUCTIONS" -eq 1 ]; then
  GATE_IDS+=(instruction-contract)
fi

if [ "${#GATE_IDS[@]}" -eq 0 ]; then
  echo "→ pre-push: no applicable Rust/Web/design/protocol/Gate changes"
  exit 0
fi

# gates/run owns aggregation, diagnostics, deduplication and fail-closed status.
exec ./gates/run "${GATE_IDS[@]}"
