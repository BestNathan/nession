# Minimal server image — packages pre-built binary + nginx + web UI
FROM debian:bullseye-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx ca-certificates curl gettext-base && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /etc/nginx/sites-enabled/default

# Stable files first — rarely change, always cache-hit
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/entrypoint-server.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
RUN mkdir -p /data /etc/nession && chown www-data:www-data /data

# Volatile files last — only these layers rebuild on each commit
# Web UI static files (built once, shared across archs)
COPY --from=web-dist / /usr/share/nginx/html/
# Binary from rust build (arch-specific)
COPY --from=server-bin /nession-server /usr/local/bin/nession-server
RUN chmod +x /usr/local/bin/nession-server

WORKDIR /etc/nession

EXPOSE 10080 18080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:10080/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
