# Nession Docker Compose variables (#3705).
# Required for the Server or full profile: the OCI Server rejects anonymous MCP.
SERVER_AUTH_TOKEN=replace-with-a-long-random-secret

# Optional: one switch for Server/Agent/Agent-remote OCI defaults.
# Set to false for emergency MCP rollback; native host config is unchanged.
NESSION_MCP_ENABLED=true

# Optional: inbound token for standalone Agent. Leave empty to have the
# Agent provision one in its persistent /data volume on first start (#3440).
# Never use a published or shared default.
# AGENT_TOKEN=replace-with-a-different-random-secret

# Optional: browser origins allowed to open the Server WebSocket (#4066).
# A browser presents an Origin on every WebSocket upgrade; the Server refuses
# an origin that is not listed. The Compose Server profile serves the Web UI
# from SERVER_HTTP_PORT, so the local defaults below keep that page working.
# A remote deployment must add the origin its browser actually uses (for
# example https://nession.example.com). CLI and Agent clients present no
# Origin and need no entry.
SERVER_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# Optional and deliberately unsafe: permit a non-loopback listener with an
# empty SERVER_AUTH_TOKEN. Never enable it on a reachable network.
# SERVER_ALLOW_INSECURE_REMOTE=true

# Optional exposed nginx ingress ports (container port 10080).
# AGENT_HTTP_PORT=13000
# SERVER_HTTP_PORT=18080

# Optional release-selected terminal columns / Web font.
# NESSION_TERMINAL_COLS=96
# NESSION_TERMINAL_WEB_FONT_SIZE=14

# Optional durable Agent EROFS cache root.
# AGENT_EROFS_STORAGE_DIR=/data/erofs
