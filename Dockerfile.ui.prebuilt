# UI prebuilt image: nginx serves pre-built web files
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# Stable nginx config — rarely changes, always cache-hit
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen 80;
    server_name _;

    location /health {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
EOF

# Source-pin the image identity (#4354). The UI image is otherwise fully
# deterministic: two SHAs with identical web content produce the same image
# config, and containerd's CRI can then report a previously pulled
# same-config image's digest as the pod imageID — breaking the deployed
# identity witness even though the pull itself was correct. The revision
# label makes every SHA's config unique, matching Dockerfile.mcp.prebuilt.
# Placed after the stable nginx config layer so its cache is preserved.
ARG NESSION_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.title="Nession Web UI" \
      org.opencontainers.image.source="https://github.com/BestNathan/nession" \
      org.opencontainers.image.revision="${NESSION_SOURCE_REVISION}"

# Volatile web files — only this layer rebuilds on each commit
COPY --from=web-dist / /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1
