      "deny": {
        "publicHost": "reject",
        "unknownHost": "reject",
        "nonLanSource": "reject",
        "wildcardFallback": "reject"
      },
      "upstream": {
        "protocol": "http",
        "tls": false,
        "exposure": "private-upstream"
      },
      "pathPolicy": "registry-route",
      "configRefs": {
        "answer": "LAN_GATEWAY_IP",
        "adguardUrl": "ADGUARD_API_URL",
        "adguardUsername": "ADGUARD_USERNAME",
        "adguardPassword": "ADGUARD_PASSWORD"
