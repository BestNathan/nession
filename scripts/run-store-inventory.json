{
  "schema_version": 1,
  "kind": "run_store_writer_inventory",
  "repository": "BestNathan/nession",
  "stores": [
    {
      "ref": "acceptance-results",
      "lifecycle": "active",
      "privacy": "public",
      "writers": [
        {
          "workflow": ".github/workflows/acceptance-case-ingest.yml",
          "source": "github-actions GITHUB_TOKEN (legacy) or scoped GitHub App installation token (app rollout)",
          "execution": "main-owned workflow_run",
          "depends_on": [
            ".github/workflows/acceptance-cases.yml"
          ],
          "permissions": [
            "contents: write",
            "issues: write"
          ],
          "app_token": {
            "when": "RUN_STORE_WRITER_MODE unset or app; legacy explicitly rolls back",
            "app_id_variable": "RUN_STORE_WRITER_APP_ID",
            "private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
            "scope": "nession: contents write",
            "trusted_job_only": true
          }
        },
        {
          "workflow": ".github/workflows/e2e-scenario-ingest.yml",
          "source": "github-actions GITHUB_TOKEN (legacy) or scoped GitHub App installation token (app rollout)",
          "execution": "main-owned workflow_run",
          "depends_on": [
            ".github/workflows/e2e-scenario-smoke.yml"
          ],
          "permissions": [
            "contents: write"
          ],
          "app_token": {
            "when": "RUN_STORE_WRITER_MODE unset or app; legacy explicitly rolls back",
            "app_id_variable": "RUN_STORE_WRITER_APP_ID",
            "private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
            "scope": "nession: contents write",
            "trusted_job_only": true
          }
        },
        {
          "workflow": ".github/workflows/e2e-test-ingest.yml",
          "source": "github-actions GITHUB_TOKEN (legacy) or scoped GitHub App installation token (app rollout)",
          "execution": "main-owned workflow_run",
          "depends_on": [
            ".github/workflows/e2e-tests.yml"
          ],
          "permissions": [
            "contents: write",
            "issues: write"
          ],
          "app_token": {
            "when": "RUN_STORE_WRITER_MODE unset or app; legacy explicitly rolls back",
            "app_id_variable": "RUN_STORE_WRITER_APP_ID",
            "private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
            "scope": "nession: contents write",
            "trusted_job_only": true
          }
        }
      ]
    },
    {
      "ref": "task-results",
      "lifecycle": "active",
      "privacy": "public",
      "writers": [
        {
          "workflow": ".github/workflows/task-result-ingest.yml",
          "source": "github-actions GITHUB_TOKEN (legacy) or scoped GitHub App installation token (app rollout)",
          "execution": "main-owned workflow_run",
          "depends_on": [
            ".github/workflows/task-runner.yml"
          ],
          "permissions": [
            "contents: write"
          ],
          "app_token": {
            "when": "RUN_STORE_WRITER_MODE unset or app; legacy explicitly rolls back",
            "app_id_variable": "RUN_STORE_WRITER_APP_ID",
            "private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
            "scope": "nession: contents write",
            "trusted_job_only": true
          }
        }
      ]
    },
    {
      "ref": "metrics",
      "lifecycle": "active",
      "privacy": "public",
      "writers": [
        {
          "workflow": ".github/workflows/metrics-agent-telemetry.yml",
          "source": "github-actions GITHUB_TOKEN (legacy) or scoped GitHub App installation token (app rollout)",
          "execution": "main-owned workflow_run and schedule",
          "depends_on": [
            ".github/workflows/agent-provider-smoke.yml",
            ".github/workflows/agent-sc-acceptance.yml",
            ".github/workflows/agent-issue-audit.yml",
            ".github/workflows/acceptance-orchestrator.yml"
          ],
          "permissions": [
            "contents: write"
          ],
          "app_token": {
            "when": "RUN_STORE_WRITER_MODE unset or app; legacy explicitly rolls back",
            "app_id_variable": "RUN_STORE_WRITER_APP_ID",
            "private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
            "scope": "nession: contents write",
            "trusted_job_only": true
          }
        },
        {
          "workflow": ".github/workflows/metrics-repository.yml",
          "source": "github-actions GITHUB_TOKEN (legacy) or scoped GitHub App installation token (app rollout)",
          "execution": "main-owned schedule and attested owner/main workflow_run replay",
          "depends_on": [
            ".github/workflows/e2e-tests.yml",
            ".github/workflows/metrics-replay-request.yml"
          ],
          "permissions": [
            "contents: write"
          ],
          "app_token": {
            "when": "RUN_STORE_WRITER_MODE unset or app; legacy explicitly rolls back",
            "app_id_variable": "RUN_STORE_WRITER_APP_ID",
            "private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
            "scope": "nession: contents write",
            "trusted_job_only": true
          }
        }
      ]
    },
    {
      "ref": "agent-store",
      "lifecycle": "active",
      "privacy": "encrypted-only",
      "writers": [
        {
          "workflow": ".github/workflows/store-agent-bootstrap.yml",
          "mode": "bootstrap",
          "event": "main_push_only",
          "source": "scoped GitHub App installation token",
          "credential_boundary": "main-owned privileged job; no model-provided writer token",
          "app_id_variable": "RUN_STORE_WRITER_APP_ID",
          "app_private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
          "app_scope": "nession: contents write"
        },
        {
          "workflow": ".github/workflows/store-agent-controller-ingest.yml",
          "mode": "controller_initialization",
          "event": "main_workflow_run",
          "source": "scoped GitHub App installation token",
          "credential_boundary": "main-owned privileged job; no model-provided writer token",
          "app_id_variable": "RUN_STORE_WRITER_APP_ID",
          "app_private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
          "app_scope": "nession: contents write"
        },
        {
          "workflow": ".github/workflows/agent-controller-dispatch.yml",
          "mode": "controller_dispatch",
          "event": "owner_main_dispatch_or_issue_comment",
          "source": "scoped GitHub App installation token",
          "credential_boundary": "main-owned privileged job; no model-provided writer token",
          "app_id_variable": "RUN_STORE_WRITER_APP_ID",
          "app_private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
          "app_scope": "nession: contents write"
        },
        {
          "workflow": ".github/workflows/store-agent-development-ingest.yml",
          "mode": "encrypted_checkpoint_ingest",
          "event": "main_workflow_run_or_owner_comment",
          "source": "scoped GitHub App installation token",
          "credential_boundary": "main-owned privileged job; no model-provided writer token",
          "app_id_variable": "RUN_STORE_WRITER_APP_ID",
          "app_private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
          "app_scope": "nession: contents write"
        },
        {
          "workflow": ".github/workflows/store-agent-dispatch-reconcile.yml",
          "mode": "failed_dispatch_reconcile",
          "event": "main_workflow_run",
          "source": "scoped GitHub App installation token",
          "credential_boundary": "main-owned privileged job; no model-provided writer token",
          "app_id_variable": "RUN_STORE_WRITER_APP_ID",
          "app_private_key_secret": "RUN_STORE_WRITER_APP_PRIVATE_KEY",
          "app_scope": "nession: contents write"
        }
      ],
      "rollout_blocker": "Current live limited-trust Writer/CAS use is evidenced by #1664; cross-writer server-side Ruleset authorization for agent-store, independent external/WORM anchoring, and production tamper drills remain deferred and UNPROVEN under #1690. Public Git may contain only sealed native session ciphertext.",
      "controller_rollout": {
        "phase": "live-verified-limited-trust",
        "request_workflow": ".github/workflows/acceptance-agent-controller.yml",
        "trusted_writer_workflow": ".github/workflows/store-agent-controller-ingest.yml",
        "trigger": "owner/main manual request -> authenticated main-owned workflow_run",
        "boundaries": "manual request read-only; new scoped App token minted after Run/Artifact verification",
        "acceptance_blocker": "Owner/main Controller, Worker and encrypted native checkpoint have live readback under #1664; full #1690 server enforcement and external anchor are deferred, not Pass."
      }
    }
  ],
  "governance": {
    "source": "Live GitHub REST API at trusted main workflow run, not this committed inventory",
    "ruleset_enforcement": "unknown_until_live_probe",
    "branch_protection": "unknown_until_live_probe",
    "secrets": "Never resolve, print or store secret values",
    "independent_anchor": "pending_offline_admin_control",
    "writer_rollout": "app-by-default after verified main smoke; explicit legacy rollback; no Ruleset before production App ingestion checks"
  }
}
