{
  "name": "@nession/pages",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Independent public Nession engineering observatory",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build:ui": "vite build",
    "build:data": "node scripts/build-data.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
