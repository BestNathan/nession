    "light": {
      "background": {
        "ref": "primitive.light.neutral.ground"
      },
      "foreground": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "card": {
        "ref": "primitive.light.neutral.ground"
      },
      "card-foreground": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "popover": {
        "ref": "primitive.light.neutral.ground"
      },
      "popover-foreground": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "primary": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "primary-foreground": {
        "ref": "primitive.light.neutral.ground"
      },
      "secondary": {
        "ref": "primitive.light.neutral.fill"
      },
      "secondary-foreground": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "muted": {
        "ref": "primitive.light.neutral.fill"
      },
      "muted-foreground": {
        "ref": "primitive.light.neutral.text-muted"
      },
      "text-secondary": {
        "ref": "primitive.light.neutral.text-secondary"
