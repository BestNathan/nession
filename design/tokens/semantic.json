      },
      "sidebar-border": {
        "ref": "primitive.light.neutral.line"
      },
      "sidebar-ring": {
        "ref": "primitive.light.neutral.text-muted"
      },
      "overlay": {
        "ref": "primitive.black"
      },
      "inverse": {
        "ref": "primitive.black"
      }
    },
