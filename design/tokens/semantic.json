      },
      "destructive": {
        "ref": "primitive.light.state.danger"
      },
      "destructive-foreground": {
        "ref": "primitive.light.neutral.ground"
      },
      "danger": {
        "ref": "semantic.destructive"
      },
      "warning": {
        "ref": "primitive.light.state.warning"
      },
      "warning-foreground": {
        "ref": "primitive.light.neutral.ground"
      },
      "border": {
        "ref": "primitive.light.neutral.line"
      },
      "input": {
        "ref": "primitive.light.neutral.boundary"
      },
      "ring": {
        "ref": "primitive.light.neutral.text-muted"
      },
      "radius": {
        "ref": "primitive.radius"
      },
      "radius-capsule": {
        "value": "calc(var(--radius) * 2.2)"
      },
      "elevation-floating": {
        "value": "0 0 0 1px oklch(0 0 0 / 6%), 0 1px 2px oklch(0 0 0 / 6%), 0 8px 24px oklch(0 0 0 / 8%)"
