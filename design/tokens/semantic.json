{
  "$description": "Semantic aliases of primitives. Light/dark maps set CSS variables that domain tokens reference.",
  "themes": {
    "light": {
      "background": { "ref": "primitive.color.white" },
      "foreground": { "ref": "primitive.color.zinc.950" },
      "card": { "ref": "primitive.color.white" },
      "card-foreground": { "ref": "primitive.color.zinc.950" },
      "popover": { "ref": "primitive.color.white" },
      "popover-foreground": { "ref": "primitive.color.zinc.950" },
      "primary": { "ref": "primitive.color.zinc.900" },
      "primary-foreground": { "ref": "primitive.color.zinc.50" },
      "secondary": { "ref": "primitive.color.zinc.100" },
      "secondary-foreground": { "ref": "primitive.color.zinc.900" },
      "muted": { "ref": "primitive.color.zinc.100" },
      "muted-foreground": { "ref": "primitive.color.zinc.500" },
      "accent": { "ref": "primitive.color.zinc.100" },
      "accent-foreground": { "ref": "primitive.color.zinc.900" },
      "destructive": { "ref": "primitive.color.red.500" },
      "destructive-foreground": { "ref": "primitive.color.zinc.50" },
      "danger": { "ref": "semantic.destructive" },
      "border": { "ref": "primitive.color.zinc.200" },
      "input": { "ref": "primitive.color.zinc.200" },
      "ring": { "ref": "primitive.color.zinc.400" },
      "radius": { "ref": "primitive.radius" },
      "chart-1": { "ref": "primitive.color.zinc.300" },
      "chart-2": { "ref": "primitive.color.zinc.500" },
      "chart-3": { "ref": "primitive.color.zinc.600" },
      "chart-4": { "ref": "primitive.color.zinc.700" },
      "chart-5": { "ref": "primitive.color.zinc.800" },
      "sidebar": { "ref": "primitive.color.zinc.50" },
      "sidebar-foreground": { "ref": "primitive.color.zinc.950" },
      "sidebar-primary": { "ref": "primitive.color.zinc.900" },
      "sidebar-primary-foreground": { "ref": "primitive.color.zinc.50" },
      "sidebar-accent": { "ref": "primitive.color.zinc.100" },
      "sidebar-accent-foreground": { "ref": "primitive.color.zinc.900" },
      "sidebar-border": { "ref": "primitive.color.zinc.200" },
      "sidebar-ring": { "ref": "primitive.color.zinc.400" },
      "success": { "ref": "primitive.color.green.500" },
      "warning": { "ref": "primitive.color.amber.500" },
      "info": { "ref": "primitive.color.blue.500" },
      "overlay": { "ref": "primitive.color.black" },
      "inverse": { "ref": "primitive.color.black" },
      "success-foreground": { "ref": "primitive.color.zinc.50" },
      "warning-foreground": { "ref": "primitive.color.zinc.50" },
      "info-foreground": { "ref": "primitive.color.zinc.50" },
      "radius-capsule": { "value": "calc(var(--radius) * 2.2)" }
    },
    "dark": {
      "background": { "ref": "primitive.color.zinc.950" },
      "foreground": { "ref": "primitive.color.zinc.50" },
      "card": { "ref": "primitive.color.zinc.900" },
      "card-foreground": { "ref": "primitive.color.zinc.50" },
      "popover": { "ref": "primitive.color.zinc.900" },
      "popover-foreground": { "ref": "primitive.color.zinc.50" },
      "primary": { "ref": "primitive.color.zinc.200" },
      "primary-foreground": { "ref": "primitive.color.zinc.900" },
      "secondary": { "ref": "primitive.color.zinc.800" },
      "secondary-foreground": { "ref": "primitive.color.zinc.50" },
      "muted": { "ref": "primitive.color.zinc.800" },
      "muted-foreground": { "ref": "primitive.color.zinc.400" },
      "accent": { "ref": "primitive.color.zinc.800" },
      "accent-foreground": { "ref": "primitive.color.zinc.50" },
      "destructive": { "ref": "primitive.color.red.400" },
      "destructive-foreground": { "ref": "primitive.color.zinc.50" },
      "danger": { "ref": "semantic.destructive" },
      "border": { "ref": "primitive.color.white-alpha.10" },
      "input": { "ref": "primitive.color.white-alpha.15" },
      "ring": { "ref": "primitive.color.zinc.500" },
      "radius": { "ref": "primitive.radius" },
      "chart-1": { "ref": "primitive.color.zinc.300" },
      "chart-2": { "ref": "primitive.color.zinc.500" },
      "chart-3": { "ref": "primitive.color.zinc.600" },
      "chart-4": { "ref": "primitive.color.zinc.700" },
      "chart-5": { "ref": "primitive.color.zinc.800" },
      "sidebar": { "ref": "primitive.color.zinc.900" },
      "sidebar-foreground": { "ref": "primitive.color.zinc.50" },
      "sidebar-primary": { "ref": "primitive.color.blue.700" },
      "sidebar-primary-foreground": { "ref": "primitive.color.zinc.50" },
      "sidebar-accent": { "ref": "primitive.color.zinc.800" },
      "sidebar-accent-foreground": { "ref": "primitive.color.zinc.50" },
      "sidebar-border": { "ref": "primitive.color.white-alpha.10" },
      "sidebar-ring": { "ref": "primitive.color.zinc.500" },
      "success": { "ref": "primitive.color.green.400" },
      "warning": { "ref": "primitive.color.amber.500" },
      "info": { "ref": "primitive.color.blue.500" },
      "overlay": { "ref": "primitive.color.black" },
      "inverse": { "ref": "primitive.color.black" },
      "success-foreground": { "ref": "primitive.color.zinc.50" },
      "warning-foreground": { "ref": "primitive.color.zinc.50" },
      "info-foreground": { "ref": "primitive.color.zinc.50" },
      "radius-capsule": { "value": "calc(var(--radius) * 2.2)" }
    }
  }
}
