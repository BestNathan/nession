      "chart-1": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "chart-2": {
        "ref": "primitive.light.neutral.text-secondary"
      },
      "chart-3": {
        "ref": "primitive.light.neutral.text-muted"
      },
      "chart-4": {
        "ref": "primitive.light.neutral.line-strong"
      },
      "chart-5": {
        "ref": "primitive.light.neutral.line"
      },
      "sidebar": {
        "ref": "primitive.light.neutral.surface"
      },
      "sidebar-foreground": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "sidebar-primary": {
        "ref": "primitive.light.neutral.text-primary"
      },
      "sidebar-primary-foreground": {
