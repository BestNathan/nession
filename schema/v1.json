{
  "schema_version": 1,
  "entry": {
    "required": [
      "id",
      "revision",
      "status",
      "title",
      "summary",
      "category",
      "sources",
      "created_at",
      "verified_at"
    ],
    "statuses": [
      "candidate",
      "verified",
      "superseded",
      "retracted"
    ],
    "id_regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "revision_regex": "^v[0-9]{4}$"
  },
  "event": {
    "required": [
      "schema_version",
      "id",
      "action",
      "recorded_at",
      "actor",
      "reason",
      "source_issue",
      "previous_revision",
      "new_revision",
      "content_sha256"
    ],
    "actions": [
      "create",
      "verify",
      "revise",
      "supersede",
      "retract"
    ]
  },
  "mutable": [
    "index.json"
  ],
  "immutable_prefixes": [
    "entries/",
    "events/",
    "schema/"
  ]
}
